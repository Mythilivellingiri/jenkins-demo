pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                // git url: 'https://github.com', branch: 'main'
            }
        }
        stage('Build') {
            steps {
                echo 'Building the application...'
                // Example for Node.js / React:
                sh 'npm install'
                sh 'npm run build'
            }
        }
        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'npm test'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh 'echo "Deployment complete!"'
            }
        }
    }
    post {
        success {
            echo 'Pipeline build succeeded!'
        }
        failure {
            echo 'Pipeline build failed!'
        }
    }
}
